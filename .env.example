# 复制为 .env 后按需修改；.env 不入库（见 .gitignore）
# 所有值在 docker compose 与 app 启动时被读取

# ---------- 通用 ----------
TZ=Asia/Shanghai

# ---------- 端口（宿主机）----------
APP_PORT=8080
WEB_PORT=80

# ---------- PostgreSQL ----------
POSTGRES_DB=codelab
POSTGRES_USER=codelab
POSTGRES_PASSWORD=change_me_pg_9f3a
POSTGRES_PORT=5432

# ---------- Redis（不持久化）----------
REDIS_PORT=6379

# ---------- RocketMQ ----------
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
# dev 下 brokerIP1 用宿主机回环，见 deploy/rocketmq/broker.conf

# ---------- MinIO（题目图片/附件；M2 起 app 通过 S3 协议读写）----------
MINIO_ROOT_USER=codelab_minio
MINIO_ROOT_PASSWORD=change_me_minio_5c81
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=codelab
# 镜像来源：Docker Hub 已无 minio 社区镜像；拉不动就换成 cgr.dev/chainguard/minio:latest 或自建 S3
MINIO_IMAGE=quay.io/minio/minio:latest
# app 侧连接串（容器内用服务名；本机直跑改成 http://127.0.0.1:9000）
MINIO_ENDPOINT=http://minio:9000

# ---------- app ----------
# 生产必须替换：>= 32 字符随机串（openssl rand -base64 48）
APP_JWT_SECRET=dev_only_change_me_please_32bytes_min_secret
# 首个管理员：启动时幂等创建（Q8）
APP_ADMIN_EMAIL=admin@example.edu
APP_ADMIN_PASSWORD=Admin@12345
# 迁移脚本目录（容器内路径；本机直跑时留空会自动探测 ../../deploy/db）
APP_DB_MIGRATION_DIR=/app/db
# 纯 HTTP 部署必须 false；上了 HTTPS 再改 true（refresh cookie 才会带 Secure）
APP_COOKIE_SECURE=false
# 允许的浏览器来源；本地 Vite + Compose 访问都要列出；云端填真实站点 origin（协议+域名+端口）
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
# 日志目录（容器内写 /app/logs，按天滚动保留 14 天）
LOG_DIR=/app/logs

# ---------- 文件存储 ----------
# 生产必须 minio；本机没有 MinIO 时用 local（只写到 LOCAL_DIR，仅供开发）
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_DIR=storage

# ---------- 判题（M2）----------
APP_JUDGE_ENABLED=true
APP_JUDGE_DIR=judge-work
APP_JUDGE_CONCURRENCY=2
APP_JUDGE_MAX_QUEUE=20
# 生产容器内设为 judge（Dockerfile 已建同名系统用户）；本机留空即直跑
APP_JUDGE_RUN_AS_USER=
APP_JUDGE_RETENTION_HOURS=24
# 截止后是否还允许提交（FR-TCH-02 的"按配置"）
APP_ASSIGNMENT_ALLOW_LATE=false

# ---------- ai 编排服务（M3）----------
# 生产必须 openai + DashScope Key；本地没有 Key 时用 stub（仅开发：确定性假回答，不产生真实调用）
AI_PROVIDER=stub
AI_MODEL=qwen-plus
DASHSCOPE_API_KEY=
# 模型服务地址（ai 侧用；app 侧的 AI_BASE_URL 指的是 ai 服务本身，见 compose）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1000
AI_TIMEOUT_SECONDS=18
# app 与 ai 之间的内部令牌，生产必须替换（openssl rand -base64 32）
AI_INTERNAL_TOKEN=dev_internal_token_change_me_32bytes_min
# app 侧 AI 开关与缓存
APP_AI_ENABLED=true
APP_AI_CACHE_TTL_MINUTES=30
APP_AI_TIMEOUT_SECONDS=25
# 配额默认值（可被 ai_quotas 按学生/教学班覆盖）
# 单题次数是"答疑+思路+分析合计口径"：一次按钮点击算 1 次，缓存命中 0 次
APP_AI_DEFAULT_DAILY_TOKENS=30000
APP_AI_DEFAULT_PER_PROBLEM_CALLS=10
# 月费用估算费率：根据当前模型官方价填写，单位为分/百万 token；留 0 时看板会标记“未配置单价”
APP_AI_INPUT_PRICE_CENTS_PER_MILLION=0
APP_AI_OUTPUT_PRICE_CENTS_PER_MILLION=0
